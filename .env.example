# cp .env.example .env 之后照着改。.env 不要提交到 git。

# ---- 镜像 ----
# 仓库是 github.com/duanly/hzy，Actions 推出来的就是这个名字
IMAGE=ghcr.io/duanly/hzy
TAG=latest                          # 想钉版本就写 sha-xxxxxxx 或 v1.2.3，回滚只改这一行

# ---- 对外端口 ----
HTTP_PORT=8080                      # http://<服务器IP>:8080 直连；前置 Caddy 也反代到这个口
TZ=Asia/Shanghai

# ---- 后台 ----
# 只在**第一次启动建 admin 这个账号时**用得上；账号建好之后改这里没用，得去后台改密码。
# 留空 = admin8888，等于门没锁，上线前务必换掉。
ADMIN_PASSWORD=

# ---- 微信登录（不用就整段留空）----
WX_APPID=
WX_SECRET=
WX_MP_APPID=
WX_MP_SECRET=

# ---- 报牌声在线合成（不用就留空，退回手机自己念）----
DASHSCOPE_API_KEY=
DASHSCOPE_TTS_MODEL=
DASHSCOPE_TTS_URL=
EDGE_TTS_URL=
EDGE_TTS_VERSION=

# ---- 调试用，生产别动 ----
# BOT_SPEED=1
# TIMER_SPEED=1
