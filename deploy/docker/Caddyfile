# 本应用自己那一层 Caddy：只管**内部路径路由**，不碰证书。
# 证书和域名分发是前面那层的事，这儿一律明文 HTTP —— 所以 auto_https 要显式关掉，
# 不关的话 Caddy 见到站点名就会自己去申请证书，在内网里必然失败、还刷一屏错。
{
	admin off
	auto_https off
	servers {
		# 前置 Caddy / 宿主机转进来的那一跳是可信的：认它带过来的 X-Forwarded-For，
		# 否则房间详情里看到的 IP 全是前置那台机器的。
		trusted_proxies static private_ranges
	}
}

:80 {
	log {
		output stdout
		format console
	}

	# ---- WebSocket：牌桌全靠它 ----
	# reverse_proxy 自带 Upgrade 透传，不用额外写头；单独拎出来是为了**不压缩**、
	# 也不让下面那条 encode 沾上它。
	@ws path /ws
	reverse_proxy @ws app:8787 {
		# 牌局一局能打半小时，默认的流超时会把连接掐了
		transport http {
			read_timeout 0
			write_timeout 0
		}
	}

	# 缓存策略**不在这儿管**。node 自己已经按请求带不带 ?v= 分了 immutable / no-cache，
	# index.html 还特意设了 no-store。这一层再 header Cache-Control 会把它**覆盖**掉 ——
	# 比如后台传了个同名的新语音包，玩家那头还抱着七天前的旧文件不放。
	# 转发就好，别替上游拿主意。（Caddyfile 只认 # 注释，没有块注释。）

	# 压缩：node 不压，这一层补上（main.js 半兆压到一百多 K）
	encode zstd gzip
	reverse_proxy app:8787
}
